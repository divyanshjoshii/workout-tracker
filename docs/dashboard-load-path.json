  "cards": [
    {
      "dot": "emerald",
      "title": "Why three rounds",
      "items": [
        "Round 1 needs nothing but the user id, so all five queries go at once",
        "Round 2 waits only because it needs the profile and the active split",
        "Round 3 is skipped entirely when the split day has no linked template"
